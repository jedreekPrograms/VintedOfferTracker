# FlipBot local/runtime configuration template.
#
# IMPORTANT: this file is documentation only. Export these variables in your
# shell/IDE/run configuration. Never commit a real .env or encryption key.

# Required by the backend. Generate a random 32-byte key and Base64-encode it.
# Linux/macOS example: export FLIPBOT_ENCRYPTION_KEY="$(openssl rand -base64 32)"
# PowerShell example:
#   $bytes = New-Object byte[] 32
#   [Security.Cryptography.RandomNumberGenerator]::Fill($bytes)
#   $env:FLIPBOT_ENCRYPTION_KEY = [Convert]::ToBase64String($bytes)
FLIPBOT_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# Optional dedicated key for encrypted Playwright cookies/localStorage.
# If omitted, the Playwright runtime falls back to FLIPBOT_ENCRYPTION_KEY.
# Use a separate 32-byte Base64 key if you want session-key rotation to be
# independent from backend credential encryption.
# FLIPBOT_SESSION_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# IMPORTANT FOR IDE RUN CONFIGURATIONS:
# the Playwright JVM must receive either FLIPBOT_SESSION_ENCRYPTION_KEY or
# FLIPBOT_ENCRYPTION_KEY if you want encrypted session persistence/migration.
# If an encrypted session exists but the worker has the wrong/missing key, the
# worker starts with a clean browser context and leaves the old ciphertext
# untouched instead of overwriting it.

# Local backend/database defaults. These are optional for the standard
# localhost Docker development setup.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/flipbot
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SERVER_PORT=8080
FLIPBOT_SERVER_ADDRESS=127.0.0.1

# Playwright runtime. Plain HTTP is accepted only for loopback hosts; use HTTPS
# if the worker is ever separated from the backend host.
FLIPBOT_BACKEND_URL=http://127.0.0.1:8080

# Docker Compose development database overrides (optional).
POSTGRES_DB=flipbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5433
